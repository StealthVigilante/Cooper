{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Existing Worker identified by its workers.dev URL.
  "name": "cooper-landing-page",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "470901",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONTACT_SEND_LIMITER",
      "namespace_id": "470902",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://cooper-landing-page.mailing-b99.workers.dev",
    "CONTACT_FROM": "Cooper Website <website@coopertechnologygroup.com>",
    "CONTACT_TO": "info@coopertechnologygroup.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGDs15FptUNoLl4_"
  },
  // Do not log request bodies, email addresses, tokens, or provider responses.
  "observability": { "enabled": false }
}
